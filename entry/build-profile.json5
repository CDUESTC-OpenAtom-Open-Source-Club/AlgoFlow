{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    },
    "arkOptions": {
      // AI_ENTRY=false hides every AI entry point; the AppGallery listing (release) build has no AI features.
      // SYNC_ENTRY=false hides sync and pairing and makes hvigorfile.ts drop the INTERNET permission.
      // The listing (release) build syncs since 1.1.0; set SYNC_ENTRY=false there to build the offline app again.
      "buildProfileFields": {
        "AI_ENTRY": true,
        "SYNC_ENTRY": true
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "buildProfileFields": {
          "AI_ENTRY": false,
          "SYNC_ENTRY": true
        },
        "obfuscation": {
          "ruleOptions": {
            "enable": true,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
    }
  ]
}