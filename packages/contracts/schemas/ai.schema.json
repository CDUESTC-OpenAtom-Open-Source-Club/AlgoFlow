{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algoflow.local/contracts/ai.schema.json",
  "title": "AlgoFlow AI contracts",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["mode", "draft_id", "draft_version", "language", "rule_version", "idea_segments"],
      "properties": {
        "mode": { "$ref": "domain.schema.json#/$defs/aiMode" },
        "draft_id": { "type": "string", "minLength": 1 },
        "draft_version": { "type": "integer", "minimum": 0 },
        "language": { "type": "string", "enum": ["cpp"] },
        "rule_version": { "type": "string", "minLength": 1 },
        "idea_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "content"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["mode", "pseudocode", "code_snippet", "assumptions", "missing_information", "risk_flags", "added_algorithm_steps", "source_draft_version", "model_id", "rule_version"],
      "properties": {
        "mode": { "$ref": "domain.schema.json#/$defs/aiMode" },
        "pseudocode": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "source_refs"],
            "properties": {
              "step": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "code_snippet": { "type": ["string", "null"] },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "added_algorithm_steps": { "type": "array", "items": { "type": "string" } },
        "source_draft_version": { "type": "integer", "minimum": 0 },
        "model_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
