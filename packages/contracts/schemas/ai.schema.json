{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algoflow.local/contracts/ai.schema.json",
  "title": "AlgoFlow AI contracts",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["mode", "draft_id", "draft_version", "language", "rule_version", "problem_context", "idea_segments", "output_kind", "visibility"],
      "properties": {
        "mode": { "$ref": "domain.schema.json#/$defs/aiMode" },
        "draft_id": { "type": "string", "minLength": 1 },
        "draft_version": { "type": "integer", "minimum": 0 },
        "language": { "type": "string", "enum": ["cpp"] },
        "rule_version": { "type": "string", "minLength": 1 },
        "problem_context": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "idea_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "content"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "output_kind": { "$ref": "domain.schema.json#/$defs/aiOutputKind" },
        "visibility": { "$ref": "domain.schema.json#/$defs/aiVisibility" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["mode", "pseudocode", "code_snippet", "code_mappings", "assumptions", "missing_information", "risk_flags", "added_algorithm_steps", "source_draft_version", "model_id", "rule_version", "output_kind", "visibility", "template_id"],
      "properties": {
        "mode": { "$ref": "domain.schema.json#/$defs/aiMode" },
        "pseudocode": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "step", "source_refs"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "step": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "code_snippet": {
          "type": ["string", "null"],
          "maxLength": 4000,
          "pattern": "^(?![\\s\\S]*\\b(?:int|signed|auto|void)\\s+main\\s*\\()[\\s\\S]*$"
        },
        "code_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step_id", "start_line", "end_line"],
            "properties": {
              "step_id": { "type": "string", "minLength": 1 },
              "start_line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "added_algorithm_steps": { "type": "array", "items": { "type": "string" } },
        "source_draft_version": { "type": "integer", "minimum": 0 },
        "model_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "output_kind": { "$ref": "domain.schema.json#/$defs/aiOutputKind" },
        "visibility": { "$ref": "domain.schema.json#/$defs/aiVisibility" },
        "template_id": { "type": ["string", "null"], "minLength": 1 }
      },
      "oneOf": [
        {
          "properties": {
            "output_kind": { "const": "pseudocode" },
            "code_snippet": { "type": "null" },
            "code_mappings": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "output_kind": { "const": "code_snippet" },
            "code_snippet": { "type": "string", "minLength": 1 },
            "code_mappings": { "minItems": 1 }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "faithful_transform" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "added_algorithm_steps": { "maxItems": 0 } }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
