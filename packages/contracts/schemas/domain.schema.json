{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algoflow.local/contracts/domain.schema.json",
  "title": "AlgoFlow domain contracts",
  "$defs": {
    "syncStatus": {
      "type": "string",
      "enum": ["local_only", "syncing", "synced", "conflict", "failed"]
    },
    "aiMode": {
      "type": "string",
      "enum": ["faithful_transform", "feasibility_analysis", "progressive_hint", "full_solution"]
    },
    "aiOutputKind": {
      "type": "string",
      "enum": ["pseudocode", "code_snippet"]
    },
    "aiVisibility": {
      "type": "string",
      "enum": ["visible", "hidden"]
    },
    "reviewKind": {
      "type": "string",
      "enum": ["explanation", "risk", "complexity"]
    },
    "diagnosticLevel": {
      "type": "string",
      "enum": ["error", "warning", "info", "hint"]
    },
    "entityMetadata": {
      "type": "object",
      "required": ["id", "version", "created_at", "updated_at", "deleted", "last_modified_client_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "deleted": { "type": "boolean" },
        "last_modified_client_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ideaSegment": {
      "allOf": [
        { "$ref": "#/$defs/entityMetadata" },
        {
          "type": "object",
          "required": ["draft_id", "position", "content"],
          "properties": {
            "draft_id": { "type": "string", "minLength": 1 },
            "position": { "type": "integer", "minimum": 0 },
            "content": { "type": "string" }
          }
        }
      ]
    },
    "draft": {
      "allOf": [
        { "$ref": "#/$defs/entityMetadata" },
        {
          "type": "object",
          "required": ["workspace_id", "title", "language", "idea_segments", "sync_status"],
          "properties": {
            "workspace_id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "maxLength": 160 },
            "language": { "type": "string", "enum": ["cpp"] },
            "idea_segments": { "type": "array", "items": { "$ref": "#/$defs/ideaSegment" } },
            "sync_status": { "$ref": "#/$defs/syncStatus" },
            "code": { "type": "string", "maxLength": 20000 }
          }
        }
      ]
    },
    "aiArtifact": {
      "type": "object",
      "required": ["id", "version", "server_sequence", "created_at", "updated_at", "deleted", "last_modified_client_id", "draft_id", "mode", "pseudocode", "code_snippet", "code_mappings", "assumptions", "missing_information", "risk_flags", "added_algorithm_steps", "source_draft_version", "model_id", "rule_version", "output_kind", "visibility", "template_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "server_sequence": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "deleted": { "type": "boolean" },
        "last_modified_client_id": { "type": "string", "minLength": 1 },
        "draft_id": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/aiMode" },
        "pseudocode": { "$ref": "ai.schema.json#/$defs/artifact/properties/pseudocode" },
        "code_snippet": { "type": ["string", "null"], "maxLength": 4000 },
        "code_mappings": { "$ref": "ai.schema.json#/$defs/artifact/properties/code_mappings" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "added_algorithm_steps": { "type": "array", "items": { "type": "string" } },
        "source_draft_version": { "type": "integer", "minimum": 0 },
        "model_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "output_kind": { "$ref": "#/$defs/aiOutputKind" },
        "visibility": { "$ref": "#/$defs/aiVisibility" },
        "template_id": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewResult": {
      "type": "object",
      "required": ["id", "version", "server_sequence", "created_at", "updated_at", "deleted", "last_modified_client_id", "draft_id", "mode", "source_draft_version", "model_id", "rule_version", "review_kind", "diagnostics", "visibility"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "server_sequence": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "deleted": { "type": "boolean" },
        "last_modified_client_id": { "type": "string", "minLength": 1 },
        "draft_id": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/aiMode" },
        "source_draft_version": { "type": "integer", "minimum": 0 },
        "model_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "review_kind": { "$ref": "#/$defs/reviewKind" },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "level", "range", "problem", "basis", "suggestion"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "level": { "$ref": "#/$defs/diagnosticLevel" },
              "range": { "oneOf": [{ "$ref": "#/$defs/sourceRange" }, { "type": "null" }] },
              "problem": { "type": "string", "minLength": 1 },
              "basis": { "type": "string", "minLength": 1 },
              "suggestion": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "visibility": { "$ref": "#/$defs/aiVisibility" }
      },
      "additionalProperties": false
    }
  }
}
